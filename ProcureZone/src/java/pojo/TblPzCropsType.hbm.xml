<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="pojo.TblPzCropsType" table="pz_crop_type" catalog="seeds_indent">
      
      <id name="cropsId" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity"></generator>
        </id>
        
        <property name="cropName" type="string">
            <column name="diivision_name" length="100" not-null="true" />
        </property>
        <property name="divisionCode" type="int">
            <column name="division_code"  not-null="true" />
        </property>
        
        <property name="divisionStatus" type="int">
            <column name="status" not-null="true" />
        </property>
  
  </class>
</hibernate-mapping>
