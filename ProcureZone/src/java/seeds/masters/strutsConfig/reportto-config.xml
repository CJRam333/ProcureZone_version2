<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">

<!-- Author: ramesh.avv -->
 
<struts>
    <package name="seeds.masters.action.ReportingToAction" extends="struts-default">
        <action name="reportingToMasterList" class="seeds.masters.action.ReportingToAction" method="getList" >            
            <result name="success">/WEB-INF/jsp/masters/reportingto_master_list.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/reportingto_master_list.jsp</result>
        </action>
        <action name="addReportingTo" class="seeds.masters.action.ReportingToAction" method="addReportingTo" >            
            <result name="success">/WEB-INF/jsp/masters/reportingto_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/reportingto_master_list.jsp</result>
        </action>
        <action name="saveReportingTo" class="seeds.masters.action.ReportingToAction" method="saveReportingTo" >            
            <result name="success" type="redirect">reportingToMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/reportingto_master.jsp</result>
        </action>
        <action name="updateReportingTo" class="seeds.masters.action.ReportingToAction" method="updateReportingTo" >            
            <result name="success">/WEB-INF/jsp/masters/reportingto_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/reportingto_master_list.jsp</result>            
        </action>
        <action name="deleteReportingTo" class="seeds.masters.action.ReportingToAction" method="deleteReportingTo" >            
            <result name="success" type="redirect">reportingToMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/reportingto_master_list.jsp</result>
        </action>
        <action name="viewReportingTo" class="seeds.masters.action.ReportingToAction" method="viewReportingTo" >            
            <result name="success">/WEB-INF/jsp/masters/reportingto_master_view.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/reportingto_master_list.jsp</result>            
        </action>
    </package>
</struts>
