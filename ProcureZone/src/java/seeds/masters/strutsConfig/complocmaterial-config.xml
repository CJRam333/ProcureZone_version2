<struts>
    <package name="seeds.masters.action.CompLocMaterialAction" extends="struts-default">
        <action name="compLocMaterialMasterList" class="seeds.masters.action.CompLocMaterialAction" method="getList" >            
            <result name="success">/WEB-INF/jsp/masters/map_comp_loc_material_master_list.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_material_master_list.jsp</result>
        </action>
        <action name="addCompLocMaterial" class="seeds.masters.action.CompLocMaterialAction" method="addCompLocMaterial" >            
            <result name="success">/WEB-INF/jsp/masters/map_comp_loc_material_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_material_master_list.jsp</result>
        </action>
        <action name="saveCompLocMaterial" class="seeds.masters.action.CompLocMaterialAction" method="saveCompLocMaterial" >            
            <result name="success" type="redirect">compLocMaterialMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_material_master.jsp</result>
        </action>
        <action name="updateCompLocMaterial" class="seeds.masters.action.CompLocMaterialAction" method="updateCompLocMaterial" >            
            <result name="success">/WEB-INF/jsp/masters/map_comp_loc_material_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_material_master_list.jsp</result>            
        </action>
        <action name="deleteCompLocMaterial" class="seeds.masters.action.CompLocMaterialAction" method="deleteCompLocMaterial" >            
            <result name="success" type="redirect">compLocMaterialMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_material_master_list.jsp</result>
        </action>
        <action name="viewCompLocMaterial" class="seeds.masters.action.CompLocMaterialAction" method="viewCompLocMaterial" >            
            <result name="success">/WEB-INF/jsp/masters/map_comp_loc_material_master_view.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_material_master_list.jsp</result>            
        </action>
    </package>
</struts>
