<struts>
    <package name="seeds.masters.action.EmployeeRolesAction" extends="struts-default">
        <action name="empRolesMasterList" class="seeds.masters.action.EmployeeRolesAction" method="getList" >            
            <result name="success">/WEB-INF/jsp/masters/employee_roles_master_list.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/employee_roles_master_list.jsp</result>
        </action>
        <action name="addEmpRoles" class="seeds.masters.action.EmployeeRolesAction" method="addEmpRoles" >            
            <result name="success">/WEB-INF/jsp/masters/employee_roles_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/employee_roles_master_list.jsp</result>
        </action>
        <action name="saveEmpRoles" class="seeds.masters.action.EmployeeRolesAction" method="saveEmpRoles" >            
            <result name="success" type="redirect">empRolesMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/employee_roles_master.jsp</result>
        </action>
        <action name="updateEmpRoles" class="seeds.masters.action.EmployeeRolesAction" method="updateEmpRoles" >            
            <result name="success">/WEB-INF/jsp/masters/employee_roles_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/employee_roles_master_list.jsp</result>            
        </action>
        <action name="deleteEmpRoles" class="seeds.masters.action.EmployeeRolesAction" method="deleteEmpRoles" >            
            <result name="success" type="redirect">empRolesMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/employee_roles_master_list.jsp</result>
        </action>
        <action name="viewEmpRoles" class="seeds.masters.action.EmployeeRolesAction" method="viewEmpRoles" >            
            <result name="success">/WEB-INF/jsp/masters/employee_roles_master_view.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/employee_roles_master_list.jsp</result>            
        </action>
    </package>
</struts>
