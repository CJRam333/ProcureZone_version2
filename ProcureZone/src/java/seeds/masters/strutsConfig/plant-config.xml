<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">

<!-- Author: ramesh.avv -->
 
<struts>
    <package name="seeds.masters.action.PlantAction" extends="struts-default">
        <action name="plantMasterList" class="seeds.masters.action.PlantAction" method="getList" >            
            <result name="success">/WEB-INF/jsp/masters/plant_master_list.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/plant_master_list.jsp</result>
        </action>
        <action name="addPlant" class="seeds.masters.action.PlantAction" method="addPlant" >            
            <result name="success">/WEB-INF/jsp/masters/plant_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/plant_master_list.jsp</result>
        </action>
        <action name="savePlant" class="seeds.masters.action.PlantAction" method="savePlant" >            
            <result name="success" type="redirect">plantMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/plant_master.jsp</result>
        </action>
        <action name="updatePlant" class="seeds.masters.action.PlantAction" method="updatePlant" >            
            <result name="success">/WEB-INF/jsp/masters/plant_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/plant_master_list.jsp</result>            
        </action>
        <action name="deletePlant" class="seeds.masters.action.PlantAction" method="deletePlant" >            
            <result name="success" type="redirect">plantMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/plant_master_list.jsp</result>
        </action>
        <action name="viewPlant" class="seeds.masters.action.PlantAction" method="viewPlant" >            
            <result name="success">/WEB-INF/jsp/masters/plant_master_view.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/plant_master_list.jsp</result>            
        </action>
    </package>
</struts>
