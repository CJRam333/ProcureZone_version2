<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">

<!-- Author: ramesh.avv -->
 
<struts>
   <package name="seeds.masters.action.CompLocAction" extends="struts-default">
        <action name="compLocMasterList" class="seeds.masters.action.CompLocAction" method="getList" >            
            <result name="success">/WEB-INF/jsp/masters/map_comp_loc_master_list.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_master_list.jsp</result>
        </action>
        <action name="addCompLoc" class="seeds.masters.action.CompLocAction" method="addCompLoc" >            
            <result name="success">/WEB-INF/jsp/masters/map_comp_loc_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_master_list.jsp</result>
        </action>
        <action name="saveCompLoc" class="seeds.masters.action.CompLocAction" method="saveCompLoc" >            
            <result name="success" type="redirect">compLocMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_master.jsp</result>
        </action>
        <action name="updateCompLoc" class="seeds.masters.action.CompLocAction" method="updateCompLoc" >            
            <result name="success">/WEB-INF/jsp/masters/map_comp_loc_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_master_list.jsp</result>            
        </action>
        <action name="deleteCompLoc" class="seeds.masters.action.CompLocAction" method="deleteCompLoc" >            
            <result name="success" type="redirect">compLocMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_master_list.jsp</result>
        </action>
        <action name="viewCompLoc" class="seeds.masters.action.CompLocAction" method="viewCompLoc" >            
            <result name="success">/WEB-INF/jsp/masters/map_comp_loc_master_view.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/map_comp_loc_master_list.jsp</result>            
        </action>
    </package>
</struts>
