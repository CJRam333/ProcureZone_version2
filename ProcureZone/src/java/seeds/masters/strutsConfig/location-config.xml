<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">

<!-- Author: ramesh.avv -->
 
<struts>
    <package name="seeds.masters.action.LocationAction" extends="struts-default">
        <action name="locationMasterList" class="seeds.masters.action.LocationAction" method="getList" >            
            <result name="success">/WEB-INF/jsp/masters/location_master_list.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/location_master_list.jsp</result>
        </action>
        <action name="addLocation" class="seeds.masters.action.LocationAction" method="addLocation" >            
            <result name="success">/WEB-INF/jsp/masters/location_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/location_master_list.jsp</result>
        </action>
        <action name="saveLocation" class="seeds.masters.action.LocationAction" method="saveLocation" >            
            <result name="success" type="redirect">locationMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/location_master.jsp</result>
        </action>
        <action name="updateLocation" class="seeds.masters.action.LocationAction" method="updateLocation" >            
            <result name="success">/WEB-INF/jsp/masters/location_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/location_master_list.jsp</result>            
        </action>
        <action name="deleteLocation" class="seeds.masters.action.LocationAction" method="deleteLocation" >            
            <result name="success" type="redirect">locationMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/location_master_list.jsp</result>
        </action>
        <action name="viewLocation" class="seeds.masters.action.LocationAction" method="viewLocation" >            
            <result name="success">/WEB-INF/jsp/masters/location_master_view.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/location_master_list.jsp</result>            
        </action>
    </package>
</struts>
