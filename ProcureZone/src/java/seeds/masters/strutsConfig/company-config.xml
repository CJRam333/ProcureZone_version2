<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">

<!-- Author: ramesh.avv -->
 
<struts>
    <package name="seeds.masters.action.CompanyAction" extends="struts-default">
        <action name="companyMasterList" class="seeds.masters.action.CompanyAction" method="getList" >            
            <result name="success">/WEB-INF/jsp/masters/company_master_list.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/company_master_list.jsp</result>
        </action>
        <action name="addCompany" class="seeds.masters.action.CompanyAction" method="addCompany" >            
            <result name="success">/WEB-INF/jsp/masters/company_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/company_master_list.jsp</result>
        </action>
        <action name="saveCompany" class="seeds.masters.action.CompanyAction" method="saveCompany" >            
            <result name="success" type="redirect">companyMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/company_master.jsp</result>
        </action>
        <action name="updateCompany" class="seeds.masters.action.CompanyAction" method="updateCompany" >            
            <result name="success">/WEB-INF/jsp/masters/company_master.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/company_master_list.jsp</result>            
        </action>
        <action name="deleteCompany" class="seeds.masters.action.CompanyAction" method="deleteCompany" >            
            <result name="success" type="redirect">companyMasterList.action</result>
            <result name="input">/WEB-INF/jsp/masters/company_master_list.jsp</result>
        </action>
        <action name="viewCompany" class="seeds.masters.action.CompanyAction" method="viewCompany" >            
            <result name="success">/WEB-INF/jsp/masters/company_master_view.jsp</result>
            <result name="input">/WEB-INF/jsp/masters/company_master_list.jsp</result>            
        </action>
    </package>
</struts>
