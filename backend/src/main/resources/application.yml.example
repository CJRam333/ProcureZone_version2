# ─────────────────────────────────────────────────────────────────────────────
# ProcureZone Backend – Application Configuration Template
# Copy this file to application.yml and fill in your local values.
# NEVER commit application.yml with real credentials.
# ─────────────────────────────────────────────────────────────────────────────

spring:
    application:
        name: procurezone-backend
    datasource:
        url: jdbc:mysql://127.0.0.1:3306/seeds_indent?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&socketTimeout=30000&connectTimeout=10000
        username: ${PROCUREZONE_DB_USERNAME:root}
        password: ${PROCUREZONE_DB_PASSWORD:YOUR_DB_PASSWORD_HERE}
        driver-class-name: com.mysql.cj.jdbc.Driver
    jpa:
        hibernate:
            ddl-auto: none
        open-in-view: false
        properties:
            hibernate:
                format_sql: true
        show-sql: true

    flyway:
      enabled: true
      baseline-on-migrate: true
      baseline-version: 20
      validate-on-migrate: false
      clean-disabled: true
      locations: classpath:db/migration


server:
    port: 8080

logging:
    level:
        root: INFO
        com.nslindia.procurezone: DEBUG
        org.springframework.security: DEBUG

jwt:
    issuer: procurezone-backend
    # Use a long random string in production (min 32 chars)
    secret: ${PROCUREZONE_JWT_SECRET:REPLACE_WITH_A_STRONG_SECRET_KEY_MIN_32_CHARS}
    access-token:
        expiration: PT1H

# Application configuration (SAP + mail sender)
app:
    sap:
        import:
            enabled: ${SAP_IMPORT_ENABLED:true}
            path: ${SAP_CSV_PATH:/path/to/sap-import}
        scheduler:
            enabled: ${SAP_SCHEDULER_ENABLED:true}
            cron: ${SAP_SCHEDULER_CRON:0 30 1 * * ?} # Daily at 1:30 AM
        archive:
            enabled: true
            path: ${SAP_CSV_ARCHIVE_PATH:/path/to/sap-import/archive}
    # Sender ("From") address applied by EmailService.setFrom(...). Real relays reject from-less mail.
    mail:
        from: ${SMTP_FROM:ezone@nslgroup.co.in}

# Email Configuration (SMTP) — fully parameterized; supply real values via env vars.
spring.mail:
    host: ${SMTP_HOST:your.smtp.server}
    port: ${SMTP_PORT:25}
    username: ${SMTP_USERNAME:}
    password: ${SMTP_PASSWORD:}
    properties:
        mail.smtp.auth: ${SMTP_AUTH:false}
        mail.smtp.starttls.enable: ${SMTP_STARTTLS:false}
    default-encoding: UTF-8

# Quartz Scheduler Configuration
spring.quartz:
    job-store-type: memory
    properties:
        org.quartz.threadPool.threadCount: 10

# Actuator Configuration
management:
    endpoint:
        health:
            show-details: always
            show-components: always
    endpoints:
        web:
            exposure:
                include: health,info,metrics
    health:
        mail:
            enabled: false
