{
  "info": {
    "name": "ProcureZone Role-Based Access Tests",
    "description": "Tests role-based access control for all 7 active users with different roles",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080/api/v1"},
    {"key": "superadminToken", "value": ""},
    {"key": "adminToken", "value": ""},
    {"key": "deptheadToken", "value": ""},
    {"key": "procurementToken", "value": ""},
    {"key": "employeeToken", "value": ""},
    {"key": "financeToken", "value": ""}
  ],
  "item": [
    {
      "name": "01-SUPERADMIN-Full-Access",
      "description": "vikram.singh - SUPERADMIN + DEPTHEAD",
      "item": [
        {
          "name": "SUPER-01: Login as SUPERADMIN",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/auth/login",
            "body": {"mode": "raw", "raw": "{\"username\": \"vikram.singh\", \"password\": \"password\"}"}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('SUPERADMIN login successful', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Has SUPERADMIN role', function() {",
              "  var json = pm.response.json();",
              "  pm.expect(json.user.roles).to.include('SUPERADMIN');",
              "});",
              "var json = pm.response.json();",
              "if (json.accessToken) { pm.collectionVariables.set('superadminToken', json.accessToken); }"
            ]}
          }]
        },
        {
          "name": "SUPER-02: Create Vendor (Should PASS)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{superadminToken}}"}
            ],
            "url": "{{baseUrl}}/vendors",
            "body": {"mode": "raw", "raw": "{\"vendorCode\": \"VND-TEST-{{$timestamp}}\", \"vendorName\": \"Test Vendor Role {{$timestamp}}\", \"vendorType\": \"Supplier\", \"contactPerson\": \"Test Contact\", \"contactPhone\": \"9876543210\", \"contactEmail\": \"testvendor@test.com\", \"addressLine1\": \"Test Address\", \"city\": \"Mumbai\", \"state\": \"Maharashtra\", \"country\": \"India\", \"pincode\": \"400001\", \"paymentTerms\": \"Net 30\"}"}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('SUPERADMIN can create vendor (status 200/201)', function() {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "pm.test('Not forbidden', function() {",
              "  pm.expect(pm.response.code).to.not.equal(403);",
              "});"
            ]}
          }]
        },
        {
          "name": "SUPER-03: Get All Employees (Should PASS)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{superadminToken}}"}],
            "url": "{{baseUrl}}/employees"
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('SUPERADMIN can view employees', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns array of employees', function() {",
              "  var json = pm.response.json();",
              "  pm.expect(json.content || json).to.be.an('array');",
              "});"
            ]}
          }]
        },
        {
          "name": "SUPER-04: Approve Indent (Admin Can)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{superadminToken}}"}
            ],
            "url": "{{baseUrl}}/indents/1/approve",
            "body": {"mode": "raw", "raw": "{\"comments\": \"Approved by test\"}"}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('SUPERADMIN can approve (not 403)', function() {",
              "  pm.expect(pm.response.code).to.not.equal(403);",
              "});"
            ]}
          }]
        },
        {
          "name": "SUPER-05: Delete Vendor (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{superadminToken}}"}],
            "url": "{{baseUrl}}/vendors/99999"
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('SUPERADMIN can delete vendor (not 403)', function() {",
              "  pm.expect(pm.response.code).to.not.equal(403);",
              "});"
            ]}
          }]
        }
      ]
    },
